# Application & Ports
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8302
API_BASE_URL=http://localhost:8302
STREAMLIT_PORT=8502
AUX_PORT=6332

# Docker Compose Project Isolation
COMPOSE_PROJECT_NAME=ai02_orderops_agent

# Embedded SQLite Operational Store
DATABASE_PATH=./data/orderops.db

# LLM Provider: local | openai | gemini | ollama
LLM_PROVIDER=local
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=20.0
LLM_MAX_RETRIES=2

# Agent Loop & Financial Guardrails
MAX_STEPS=5
MAX_TOKEN_BUDGET=4096
MAX_INPUT_CHARS=1500
AUTO_REFUND_LIMIT_VND=500000
RETURN_WINDOW_DAYS=14
